# === YoUprefer — Variáveis de Ambiente ===
# Cópia este arquivo como .env e preencha os valores.

# --- Ambiente ---
ENV=development           # development | production | testing

# --- Segurança (OBRIGATÓRIO em produção) ---
SECRET_KEY=changeme-to-a-random-secret-at-least-32-chars

# --- Banco de Dados ---
# PostgreSQL (produção):
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=youprefer

# Alternativa: URL direta (sobrescreve as configs acima)
# DATABASE_URL=postgresql://user:pass@host:5432/db

# SQLite (apenas dev/test):
# ALLOW_SQLITE=true
# DATABASE_URL=sqlite:///./youprefer.db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
# Em desenvolvimento, pode usar fail-open para não depender de Redis:
RATE_LIMIT_FAIL_OPEN=false

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=10

# --- Cloudflare R2 (Storage de Imagens) ---
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=          # Ex: https://pub-xxx.r2.dev

# --- CORS (orígenes permitidos) ---
# Produção: lista explícita separada por vírgulas
# Ex: https://youprefer.com,https://www.youprefer.com
BACKEND_CORS_ORIGINS=

# --- OAuth ---
GOOGLE_OAUTH_CLIENT_IDS=   # JSON array ou lista separada por vírgulas
FACEBOOK_OAUTH_APP_ID=

# --- JWT ---
# ACCESS_TOKEN_EXPIRE_MINUTES=11520   # 8 dias (default)
# REFRESH_TOKEN_EXPIRE_DAYS=30        # 30 dias (default)
